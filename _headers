# Security headers. Understood by Netlify and Cloudflare Pages.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'self'; form-action 'self' mailto:; connect-src 'self' https://ozolfqmptcpiuacbvssy.supabase.co; frame-ancestors 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
